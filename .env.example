# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in real values.
# IMPORTANT: `.env` is gitignored and must NEVER be committed, because it may
# contain local test database credentials.
# ---------------------------------------------------------------------------

# Port the application listens on (REQUIRED: must be 30002 per spec)
PORT=30002

# Database connection string (PostgreSQL)
# Local dev / testing example:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tickets?schema=public"

# Single-user login credentials (used by /login and /api/login)
APP_USERNAME=admin
APP_PASSWORD=changeme

# Session secret used to sign the auth cookie (any long random string)
SESSION_SECRET=please-change-me-to-a-long-random-string-at-least-32-chars
